PAYLOAD_SECRET=mygeneratedsecret
DATABASE_URL=mongodb://127.0.0.1/template-ecommerce

COMPANY_NAME="Mixie Kadai"
TWITTER_CREATOR="@mixie_kadai"
TWITTER_SITE="https://www.instagram.com/mixie_kadai"
SITE_NAME="Mixie Kadai"

PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
# Production: https://www.mixiekadai.lk
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel Blob (required on Vercel — local disk uploads are not persisted between deploys)
# Vercel injects BLOB_READ_WRITE_TOKEN at runtime; it cannot be copied from the dashboard.
# For local bulk upload use sync:media-prod instead (no blob token needed).
BLOB_READ_WRITE_TOKEN=

# Admin credentials for `pnpm sync:media-prod` (uploads via production API → Blob on server)
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=

# SMTP (Brevo or any provider)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=orders@mixiekadai.lk
EMAIL_FROM_NAME=Mixie Kade

# Used to preview drafts
PREVIEW_SECRET=demo-draft-secret

# Stripe API keys
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_
